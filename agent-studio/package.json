{
  "name": "agent-studio",
  "productName": "Студия агентов",
  "version": "0.1.0",
  "private": true,
  "description": "Личная карта ИИ-агентов: блоки, связи, шаги, промпты и модели.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.agentstudio",
    "productName": "AgentStudio",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "AgentStudio-${version}.exe"
    }
  }
}
